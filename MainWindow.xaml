<Window x:Class="MyExecutor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaX Executor" Height="450" Width="700"
        Background="#121218" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- مربع كتابة السكربتات -->
        <TextBox x:Name="ScriptBox" Grid.Row="0" Background="#1a1a24" Foreground="#00ffff" 
                 BorderBrush="#33334d" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" 
                 FontFamily="Consolas" FontSize="14" Padding="10"/>

        <!-- أزرار التحكم -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Execute" Width="100" Height="35" Background="#00ffff" Foreground="#121218" FontWeight="Bold" Click="Execute_Click" Margin="0,0,10,0"/>
            <Button Content="Attach" Width="100" Height="35" Background="#ff00ff" Foreground="White" FontWeight="Bold" Click="Attach_Click" Margin="0,0,10,0"/>
            <Button Content="Clear All" Width="100" Height="35" Background="#33334d" Foreground="White" FontWeight="Bold" Click="Clear_Click" Margin="0,0,10,0"/>
            <Button Content="Close All" Width="100" Height="35" Background="#ff3333" Foreground="White" FontWeight="Bold" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>